{
  "name": "qoorus-vn-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./pwa",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qoorus-vn-poc-db",
      "database_id": "f527d0b6-a4a1-4367-af07-e6d5f1ac87f8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATUS_CACHE",
      "id": "4c18e01c9ced4fc882c2bd4b5e6717da"
    }
  ]
}
